# Copy to .env and fill in. Never commit .env.
#
# .env is the ONLY place any credential for this project is stored. The tracked
# files carry no secret values, so this repo is safe to publish. Keep it that way:
# do not paste a real key into README, docs/, or this template.
#
# Handling notes live at the top of .env itself.

# ─── Camera RTSP ───────────────────────────────────────────────────────────
# The camera's password contains '@', which MUST be percent-encoded as %40
# inside an RTSP URL. A literal '@' silently truncates the credentials.
# Encode it once here; every variable below expects the ENCODED form.
CAM_RTSP_USER=admin
CAM_RTSP_PASSWORD_ENCODED=change%40me

CAM_IP=192.168.1.46
CAM_PORT=554

# Built from the three above. Frigate substitutes these at runtime.
FRIGATE_CAM_MAIN_URL=rtsp://admin:change%40me@192.168.1.46:554/onvif1
FRIGATE_CAM_SUB_URL=rtsp://admin:change%40me@192.168.1.46:554/onvif2

# ─── Storage — local only, no cloud archive ────────────────────────────────
# Where recordings land. Point this at a large disk on the laptop before
# running; leaving it relative keeps Docker from creating a root-owned
# directory at an absolute path it does not own.
FRIGATE_MEDIA_PATH=./media

# How many days of footage to keep. This IS the retention policy — there is no
# offsite copy, so a value larger than the disk allows will fill it and Frigate
# will start evicting the oldest footage early.
#
# Measured on this camera: the main stream writes ~9.5 GB/day
# (943 kbps, of which 128 kbps is audio).
#
#   days    disk needed
#   ----    -----------
#     7        66 GB
#    10        95 GB
#    14       133 GB
#    30       285 GB
#    60       569 GB
#    90       854 GB
#
# Drop the `audio` role in frigate/config.yml to save a further ~1.3 GB/day.
FRIGATE_RETAIN_DAYS=10

# Snapshot retention, in days. Snapshots are small; keep them longer than the
# footage if you want a visual history after the video has aged out.
FRIGATE_SNAPSHOT_DAYS=30

# ─── Housekeeping ──────────────────────────────────────────────────────────
TZ=Africa/Johannesburg
