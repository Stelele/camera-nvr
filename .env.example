# Copy to .env and fill in. Never commit .env.
#
# .env is the ONLY place any credential for this project is stored. The tracked
# files carry no secret values, so this repo is safe to publish. Keep it that way:
# do not paste a real key into README, docs/, or this template.
#
# Handling notes live at the top of .env itself.

# ─── Camera RTSP ───────────────────────────────────────────────────────────
# The camera's password contains '@', which MUST be percent-encoded as %40
# inside an RTSP URL. A literal '@' silently truncates the credentials.
# Encode it once here; every variable below expects the ENCODED form.
CAM_RTSP_USER=admin
CAM_RTSP_PASSWORD_ENCODED=change%40me

CAM_IP=192.168.1.46
CAM_PORT=554

# Built from the three above. Frigate substitutes these at runtime.
FRIGATE_CAM_MAIN_URL=rtsp://admin:change%40me@192.168.1.46:554/onvif1
FRIGATE_CAM_SUB_URL=rtsp://admin:change%40me@192.168.1.46:554/onvif2

# ─── Cloudflare R2 ─────────────────────────────────────────────────────────
# Matches the convention already used in cms-system and njeremoto-operations.
# All three of ACCOUNT_ID / ACCESS_KEY_ID / SECRET_ACCESS_KEY are required —
# r2-sync.sh refuses to start without them rather than archiving nothing.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

R2_BUCKET=camera-archive

# Optional: derived from the account id if left as-is.
# There is no rclone.conf to edit — r2-sync.sh generates it from these values.
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# ─── Retention ──────────────────────────────────────────────────────────────
# Days kept on the LOCAL disk. R2 is the long-term archive, so this can be short.
LOCAL_RETENTION_DAYS=2
# Minutes between upload passes
R2_SYNC_INTERVAL_MINUTES=15